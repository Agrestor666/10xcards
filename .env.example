SUPABASE_URL=###
SUPABASE_KEY=###
# Server-only; never commit real values. Required for account deletion in production.
SUPABASE_SERVICE_ROLE_KEY=###
OPENROUTER_API_KEY=###
# Cloudflare Turnstile. These are the official always-pass dummy keys (localhost and siteverify).
# Replace both before production deploy; never commit real secrets.
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# Playwright E2E auth setup (e2e/auth.setup.ts) — set in .env only, never commit real values
E2E_USER_EMAIL=###
E2E_USER_PASSWORD=###
# Second account used to prove cross-user RLS isolation
E2E_USER_B_EMAIL=###
E2E_USER_B_PASSWORD=###