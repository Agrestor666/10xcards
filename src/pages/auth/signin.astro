---
import Layout from "@/layouts/Layout.astro";
import PaperShell from "@/components/layout/PaperShell.astro";
import SignInForm from "@/components/auth/SignInForm";

const error = Astro.url.searchParams.get("error");
---

<Layout title="Sign in">
  <PaperShell class="flex min-h-screen items-center justify-center py-12">
    <div class="border-border bg-card w-full max-w-sm rounded-2xl border p-8 shadow-sm">
      <h1 class="font-display mb-6 text-center text-2xl tracking-tight">Sign in</h1>
      <SignInForm serverError={error} client:load />
      <p class="text-muted-foreground mt-4 text-center text-sm">
        Don't have an account? <a href="/auth/signup" class="text-primary font-medium hover:underline">Sign up</a>
      </p>
    </div>
  </PaperShell>
</Layout>
