---
import Layout from "@/layouts/Layout.astro";
import PaperShell from "@/components/layout/PaperShell.astro";
import ResetPasswordForm from "@/components/auth/ResetPasswordForm";
import { resolveAuthErrorMessage } from "@/lib/auth-errors";
import { t } from "@/lib/i18n";
import { RECOVERY_COOKIE } from "@/lib/password-recovery";

const locale = Astro.locals.locale;
const errorParam = Astro.url.searchParams.get("error");
const invalid = !Astro.locals.user || errorParam === "link_invalid";
const hasRecoveryMarker = Boolean(Astro.cookies.get(RECOVERY_COOKIE)?.value);

if (!invalid && !hasRecoveryMarker) {
  return Astro.redirect("/dashboard");
}

const serverError = invalid ? null : resolveAuthErrorMessage(locale, errorParam);
---

<Layout title={t(locale, "pages.reset_password.title")}>
  <PaperShell class="flex min-h-screen items-center justify-center py-12">
    <div class="border-border bg-card w-full max-w-sm rounded-2xl border p-8 shadow-sm">
      {
        invalid ? (
          <div class="text-center">
            <h1 class="font-display mb-3 text-2xl tracking-tight">{t(locale, "auth.reset.invalid.heading")}</h1>
            <p class="text-muted-foreground mb-6 text-sm">{t(locale, "auth.reset.invalid.description")}</p>
            <a href="/auth/forgot-password" class="text-primary text-sm font-medium hover:underline">
              {t(locale, "auth.reset.invalid.link")}
            </a>
          </div>
        ) : (
          <>
            <h1 class="font-display mb-6 text-center text-2xl tracking-tight">{t(locale, "auth.reset.heading")}</h1>
            <ResetPasswordForm locale={locale} serverError={serverError} client:load />
          </>
        )
      }
    </div>
  </PaperShell>
</Layout>
