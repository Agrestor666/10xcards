---
import Layout from "@/layouts/Layout.astro";
import PaperShell from "@/components/layout/PaperShell.astro";
import { t } from "@/lib/i18n";

const locale = Astro.locals.locale;
---

<Layout title={t(locale, "pages.check_email.title")}>
  <PaperShell class="flex min-h-screen items-center justify-center py-12">
    <div class="border-border bg-card w-full max-w-sm rounded-2xl border p-8 text-center shadow-sm">
      <div class="mb-4 text-5xl">📧</div>
      <h1 class="font-display mb-3 text-2xl tracking-tight">{t(locale, "auth.check_email.heading")}</h1>
      <p class="text-muted-foreground mb-6 text-sm">{t(locale, "auth.check_email.description")}</p>
      <a href="/auth/signin" class="text-primary text-sm font-medium hover:underline">
        {t(locale, "auth.check_email.link")}
      </a>
    </div>
  </PaperShell>
</Layout>
