---
import Layout from "@/layouts/Layout.astro";
import PaperShell from "@/components/layout/PaperShell.astro";
import { t } from "@/lib/i18n";

const locale = Astro.locals.locale;
const isAutoConfirmed = import.meta.env.DEV;

const content = isAutoConfirmed
  ? {
      emoji: "✅",
      headingKey: "auth.confirm.auto.heading" as const,
      descriptionKey: "auth.confirm.auto.description" as const,
      linkKey: "auth.confirm.auto.link" as const,
    }
  : {
      emoji: "📧",
      headingKey: "auth.confirm.email.heading" as const,
      descriptionKey: "auth.confirm.email.description" as const,
      linkKey: "auth.confirm.email.link" as const,
    };
---

<Layout title={t(locale, content.headingKey)}>
  <PaperShell class="flex min-h-screen items-center justify-center py-12">
    <div class="border-border bg-card w-full max-w-sm rounded-2xl border p-8 text-center shadow-sm">
      <div class="mb-4 text-5xl">{content.emoji}</div>
      <h1 class="font-display mb-3 text-2xl tracking-tight">{t(locale, content.headingKey)}</h1>
      <p class="text-muted-foreground mb-6 text-sm">{t(locale, content.descriptionKey)}</p>
      <a href="/auth/signin" class="text-primary text-sm font-medium hover:underline">
        {t(locale, content.linkKey)}
      </a>
    </div>
  </PaperShell>
</Layout>
