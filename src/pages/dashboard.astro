---
import Layout from "@/layouts/Layout.astro";
import Topbar from "@/components/Topbar.astro";
import type { FlashcardSet } from "@/types";
import { SUPABASE_NOT_CONFIGURED_MESSAGE } from "@/lib/flashcard-set-errors";
import { createClient } from "@/lib/supabase";
import { FlashcardGenerator } from "@/components/generator/FlashcardGenerator";

const { user } = Astro.locals;

const errorMessage = Astro.url.searchParams.get("error");

const supabase = createClient(Astro.request.headers, Astro.cookies);

let sets: Pick<FlashcardSet, "id" | "name" | "created_at" | "updated_at">[] = [];
let setsLoadError: string | null = null;

if (!supabase) {
  setsLoadError = SUPABASE_NOT_CONFIGURED_MESSAGE;
} else {
  const { data, error } = await supabase
    .from("flashcard_sets")
    .select("id,name,created_at,updated_at")
    .order("updated_at", { ascending: false });

  if (error) {
    setsLoadError = "Could not load your sets. Please refresh.";
  } else {
    sets = data;
  }
}
---

<Layout title="Sets">
  <div class="bg-cosmic min-h-screen p-4 text-white">
    <div class="mx-auto flex w-full max-w-3xl flex-col gap-4 pt-6">
      <Topbar />
      <header class="rounded-2xl border border-white/10 bg-white/10 p-6 backdrop-blur-xl">
        <h1 class="bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-3xl font-bold text-transparent">
          Your sets
        </h1>
        <p class="mt-2 text-sm text-blue-100/70">
          Signed in as <span class="font-medium text-white">{user?.email}</span>
        </p>
      </header>

      {
        (errorMessage ?? setsLoadError) && (
          <div class="rounded-xl border border-red-400/20 bg-red-500/10 px-4 py-3 text-sm text-red-100">
            {errorMessage ?? setsLoadError}
          </div>
        )
      }

      <section class="rounded-2xl border border-white/10 bg-white/10 p-6 backdrop-blur-xl">
        <h2 class="text-lg font-semibold text-white">Create a new set</h2>
        <form method="POST" action="/api/flashcard-sets/create" class="mt-4 flex flex-col gap-3 sm:flex-row">
          <input
            type="text"
            name="name"
            placeholder="e.g. Biology"
            maxlength="80"
            required
            class="w-full flex-1 rounded-lg border border-white/10 bg-white/5 px-3 py-2 text-white placeholder:text-white/40 focus:border-purple-300/50 focus:ring-2 focus:ring-purple-300/20 focus:outline-none"
          />
          <button
            type="submit"
            class="rounded-lg border border-white/10 bg-purple-500/20 px-4 py-2 text-sm font-medium text-white transition-colors hover:bg-purple-500/30"
          >
            Create
          </button>
        </form>
        <p class="mt-3 text-xs text-blue-100/60">Name must be 1–80 characters.</p>
      </section>

      <FlashcardGenerator client:load sets={sets.map((s) => ({ id: s.id, name: s.name }))} />

      <section class="rounded-2xl border border-white/10 bg-white/10 p-6 backdrop-blur-xl">
        <h2 class="text-lg font-semibold text-white">All sets</h2>

        {
          sets.length === 0 ? (
            <div class="mt-4 rounded-xl border border-white/10 bg-white/5 px-4 py-6 text-sm text-blue-100/70">
              You don’t have any sets yet. Create your first one above.
            </div>
          ) : (
            <ul class="mt-4 divide-y divide-white/10 overflow-hidden rounded-xl border border-white/10 bg-white/5">
              {sets.map((set) => (
                <li class="flex items-center justify-between gap-3 px-4 py-3">
                  <div class="flex flex-col">
                    <a
                      href={`/sets/${set.id}`}
                      class="font-medium text-white transition-colors hover:text-purple-200 hover:underline focus:text-purple-200 focus:underline focus:outline-none"
                    >
                      {set.name}
                    </a>
                    <span class="mt-1 font-mono text-[11px] text-blue-100/60">{set.id}</span>
                  </div>
                  <span class="text-xs text-blue-100/50">Updated {new Date(set.updated_at).toLocaleDateString()}</span>
                </li>
              ))}
            </ul>
          )
        }
      </section>
    </div>
  </div>
</Layout>
