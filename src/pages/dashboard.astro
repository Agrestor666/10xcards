---
import Layout from "@/layouts/Layout.astro";
import AppTopbar from "@/components/layout/AppTopbar.astro";
import PaperShell from "@/components/layout/PaperShell.astro";
import { StudyHero } from "@/components/dashboard/StudyHero";
import { SetDashboardGrid } from "@/components/dashboard/SetDashboardGrid";
import { FlashcardGenerator } from "@/components/generator/FlashcardGenerator";
import { loadDashboardSets } from "@/lib/load-dashboard-sets";

const { user } = Astro.locals;

const errorMessage = Astro.url.searchParams.get("error");

const {
  sets: dashboardSets,
  totalDue,
  error: setsLoadError,
} = await loadDashboardSets(Astro.request.headers, Astro.cookies);

const generatorSets = dashboardSets.map((s) => ({ id: s.id, name: s.name }));
---

<Layout title="Dashboard">
  <PaperShell class="max-w-3xl">
    <AppTopbar />
    {
      user?.email && (
        <p class="text-muted-foreground mb-4 text-sm">
          Signed in as <span class="text-foreground font-medium">{user.email}</span>
        </p>
      )
    }

    {
      (errorMessage ?? setsLoadError) && (
        <div class="border-destructive/30 bg-destructive/10 text-destructive mb-4 rounded-xl border px-4 py-3 text-sm">
          {errorMessage ?? setsLoadError}
        </div>
      )
    }

    {!setsLoadError && <StudyHero client:load initialTotalDue={totalDue} hasSets={dashboardSets.length > 0} />}

    {
      !setsLoadError && (
        <section class="mt-6">
          <SetDashboardGrid client:load initialSets={dashboardSets} />
        </section>
      )
    }

    <details class="border-border bg-card mt-6 rounded-xl border shadow-sm">
      <summary class="cursor-pointer px-5 py-4 text-sm font-medium">Generate flashcards with AI</summary>
      <div class="border-border border-t px-5 pb-5">
        <FlashcardGenerator client:load sets={generatorSets} />
      </div>
    </details>
  </PaperShell>
</Layout>
