---
import Layout from "@/layouts/Layout.astro";
import Topbar from "@/components/Topbar.astro";
import { SetFlashcardsManager } from "@/components/flashcards/SetFlashcardsManager";
import { loadSetDetailPage } from "@/lib/load-set-detail";

const loaded = await loadSetDetailPage(Astro.params.id, Astro.request.headers, Astro.cookies);

if (loaded.kind === "redirect") {
  return Astro.redirect(loaded.url);
}

const { set: setRow, initialCards, cardsLoadError } = loaded;
---

<Layout title={setRow.name}>
  <div class="bg-cosmic min-h-screen p-4 text-white">
    <div class="mx-auto flex w-full max-w-3xl flex-col gap-4 pt-6">
      <Topbar />
      <header class="rounded-2xl border border-white/10 bg-white/10 p-6 backdrop-blur-xl">
        <a href="/dashboard" class="text-sm text-purple-300 transition-colors hover:text-purple-100 hover:underline">
          ← Back to sets
        </a>
        <h1 class="mt-3 bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-3xl font-bold text-transparent">
          {setRow.name}
        </h1>
        {cardsLoadError && <p class="mt-2 text-sm text-red-100">Could not load cards. Please refresh.</p>}
      </header>

      <SetFlashcardsManager client:load setId={setRow.id} setName={setRow.name} initialCards={initialCards} />
    </div>
  </div>
</Layout>
