---
import Layout from "@/layouts/Layout.astro";
import Topbar from "@/components/Topbar.astro";
import { loadSetMetaPage } from "@/lib/load-set-detail";
import { ReviewSession } from "@/components/srs/ReviewSession";

const loaded = await loadSetMetaPage(Astro.params.id, Astro.request.headers, Astro.cookies);

if (loaded.kind === "redirect") {
  return Astro.redirect(loaded.url);
}

const setMeta = loaded.set;
---

<Layout title={`Review — ${setMeta.name}`}>
  <div class="bg-cosmic min-h-screen p-4 text-white">
    <div class="mx-auto flex w-full max-w-3xl flex-col gap-4 pt-6">
      <Topbar />
      <header class="rounded-2xl border border-white/10 bg-white/10 p-6 backdrop-blur-xl">
        <a
          href={`/sets/${setMeta.id}`}
          class="text-sm text-purple-300 transition-colors hover:text-purple-100 hover:underline"
        >
          ← Back to set
        </a>
        <h1 class="mt-3 bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-3xl font-bold text-transparent">
          Review session
        </h1>
        <p class="mt-2 text-sm text-blue-100/70">Set: {setMeta.name}</p>
      </header>

      <ReviewSession client:load setId={setMeta.id} setName={setMeta.name} />
    </div>
  </div>
</Layout>
