---
import Layout from "@/layouts/Layout.astro";
import AppTopbar from "@/components/layout/AppTopbar.astro";
import PaperShell from "@/components/layout/PaperShell.astro";
import { loadSetMetaPage } from "@/lib/load-set-detail";
import { ReviewSession } from "@/components/srs/ReviewSession";
import { t } from "@/lib/i18n";

const { locale } = Astro.locals;

const loaded = await loadSetMetaPage(Astro.params.id, Astro.locals.supabase);

if (loaded.kind === "redirect") {
  return Astro.redirect(loaded.url);
}

const setMeta = loaded.set;
---

<Layout title={t(locale, "pages.review.title", { name: setMeta.name })}>
  <PaperShell class="max-w-3xl">
    <AppTopbar />
    <header class="border-border bg-card rounded-2xl border p-6 shadow-sm">
      <a href={`/sets/${setMeta.id}`} class="text-primary text-sm font-medium transition-colors hover:underline">
        {t(locale, "review.back_to_set")}
      </a>
      <h1 class="font-display mt-3 text-3xl tracking-tight">{t(locale, "review.session_title")}</h1>
      <p class="text-muted-foreground mt-2 text-sm">{t(locale, "review.set_label", { name: setMeta.name })}</p>
    </header>

    <ReviewSession client:load locale={locale} setId={setMeta.id} setName={setMeta.name} />
  </PaperShell>
</Layout>
