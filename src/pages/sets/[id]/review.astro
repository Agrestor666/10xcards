---
import Layout from "@/layouts/Layout.astro";
import Topbar from "@/components/Topbar.astro";
import { z } from "zod";
import { SUPABASE_NOT_CONFIGURED_MESSAGE } from "@/lib/flashcard-set-errors";
import { createClient } from "@/lib/supabase";
import { ReviewSession } from "@/components/srs/ReviewSession";

const rawId = Astro.params.id;
if (!rawId || !z.uuid().safeParse(rawId).success) {
  return Astro.redirect(`/dashboard?error=${encodeURIComponent("Invalid set")}`);
}

const supabase = createClient(Astro.request.headers, Astro.cookies);
if (!supabase) {
  return Astro.redirect(`/dashboard?error=${encodeURIComponent(SUPABASE_NOT_CONFIGURED_MESSAGE)}`);
}

const { data: setRow, error: setError } = await supabase
  .from("flashcard_sets")
  .select("id,name")
  .eq("id", rawId)
  .maybeSingle();

if (setError || !setRow) {
  return Astro.redirect(`/dashboard?error=${encodeURIComponent("Set not found")}`);
}

const setMetaSchema = z.object({
  id: z.uuid(),
  name: z.string(),
});
const parsedSet = setMetaSchema.safeParse(setRow);
if (!parsedSet.success) {
  return Astro.redirect(`/dashboard?error=${encodeURIComponent("Set not found")}`);
}

const setMeta = parsedSet.data;
---

<Layout title={`Review — ${setMeta.name}`}>
  <div class="bg-cosmic min-h-screen p-4 text-white">
    <div class="mx-auto flex w-full max-w-3xl flex-col gap-4 pt-6">
      <Topbar />
      <header class="rounded-2xl border border-white/10 bg-white/10 p-6 backdrop-blur-xl">
        <a
          href={`/sets/${setMeta.id}`}
          class="text-sm text-purple-300 transition-colors hover:text-purple-100 hover:underline"
        >
          ← Back to set
        </a>
        <h1 class="mt-3 bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-3xl font-bold text-transparent">
          Review session
        </h1>
        <p class="mt-2 text-sm text-blue-100/70">Set: {setMeta.name}</p>
      </header>

      <ReviewSession client:load setId={setMeta.id} setName={setMeta.name} />
    </div>
  </div>
</Layout>
