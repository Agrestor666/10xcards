---
import Layout from "@/layouts/Layout.astro";
import AppTopbar from "@/components/layout/AppTopbar.astro";
import PaperShell from "@/components/layout/PaperShell.astro";
import { SetFlashcardsManager } from "@/components/flashcards/SetFlashcardsManager";
import { loadSetDetailPage } from "@/lib/load-set-detail";
import { cn } from "@/lib/utils";

const loaded = await loadSetDetailPage(Astro.params.id, Astro.request.headers, Astro.cookies);

if (loaded.kind === "redirect") {
  return Astro.redirect(loaded.url);
}

const { set: setRow, initialCards, cardsLoadError } = loaded;
const reviewUrl = `/sets/${setRow.id}/review`;
---

<Layout title={setRow.name}>
  <PaperShell class="max-w-3xl">
    <AppTopbar />
    <header class="border-border bg-card rounded-2xl border p-6 shadow-sm">
      <a href="/dashboard" class="text-primary text-sm font-medium transition-colors hover:underline"> ← Dashboard </a>
      <h1 class="font-display mt-3 text-3xl tracking-tight">{setRow.name}</h1>
      {cardsLoadError && <p class="text-destructive mt-2 text-sm">Could not load cards. Please refresh.</p>}

      <div class="mt-5 flex flex-wrap items-center gap-3">
        <a
          href={reviewUrl}
          class:list={cn(
            "bg-primary text-primary-foreground hover:bg-primary/90 inline-flex items-center justify-center rounded-md px-4 py-2 text-sm font-medium shadow-xs transition-colors",
            "focus-visible:ring-ring/50 focus-visible:ring-[3px] focus-visible:outline-none",
          )}
        >
          Start review
        </a>
      </div>
    </header>

    <SetFlashcardsManager client:load setId={setRow.id} setName={setRow.name} initialCards={initialCards} />
  </PaperShell>
</Layout>
