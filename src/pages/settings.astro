---
import Layout from "@/layouts/Layout.astro";
import Topbar from "@/components/Topbar.astro";
import { AccountDangerZone } from "@/components/account/AccountDangerZone";
import { SUPABASE_NOT_CONFIGURED_MESSAGE } from "@/lib/flashcard-set-errors";
import { createClient } from "@/lib/supabase";

const { user } = Astro.locals;

const supabase = createClient(Astro.request.headers, Astro.cookies);

let setCount = 0;
let cardCount = 0;
let statsLoadError: string | null = null;

if (!supabase) {
  statsLoadError = SUPABASE_NOT_CONFIGURED_MESSAGE;
} else {
  const [setsResult, cardsResult] = await Promise.all([
    supabase.from("flashcard_sets").select("id", { count: "exact", head: true }),
    supabase.from("flashcards").select("id", { count: "exact", head: true }),
  ]);

  if (setsResult.error || cardsResult.error) {
    statsLoadError = "Could not load account stats. Please refresh.";
  } else {
    setCount = setsResult.count ?? 0;
    cardCount = cardsResult.count ?? 0;
  }
}
---

<Layout title="Settings">
  <div class="bg-cosmic min-h-screen p-4 text-white">
    <div class="mx-auto flex w-full max-w-3xl flex-col gap-4 pt-6">
      <Topbar />
      <header class="rounded-2xl border border-white/10 bg-white/10 p-6 backdrop-blur-xl">
        <h1 class="bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-3xl font-bold text-transparent">
          Settings
        </h1>
        <p class="mt-2 text-sm text-blue-100/70">
          Signed in as <span class="font-medium text-white">{user?.email}</span>
        </p>
      </header>

      {
        statsLoadError && (
          <div class="rounded-xl border border-red-400/20 bg-red-500/10 px-4 py-3 text-sm text-red-100">
            {statsLoadError}
          </div>
        )
      }

      {
        user?.email && (
          <AccountDangerZone
            client:load
            email={user.email}
            setCount={setCount}
            cardCount={cardCount}
            statsUnavailable={!!statsLoadError}
          />
        )
      }
    </div>
  </div>
</Layout>
