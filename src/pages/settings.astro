---
import Layout from "@/layouts/Layout.astro";
import AppTopbar from "@/components/layout/AppTopbar.astro";
import PaperShell from "@/components/layout/PaperShell.astro";
import { AccountDangerZone } from "@/components/account/AccountDangerZone";
import { SUPABASE_NOT_CONFIGURED_MESSAGE } from "@/lib/flashcard-set-errors";
import { createClient } from "@/lib/supabase";

const { user } = Astro.locals;

const supabase = createClient(Astro.request.headers, Astro.cookies);

let setCount = 0;
let cardCount = 0;
let statsLoadError: string | null = null;

if (!supabase) {
  statsLoadError = SUPABASE_NOT_CONFIGURED_MESSAGE;
} else {
  const [setsResult, cardsResult] = await Promise.all([
    supabase.from("flashcard_sets").select("id", { count: "exact", head: true }),
    supabase.from("flashcards").select("id", { count: "exact", head: true }),
  ]);

  if (setsResult.error || cardsResult.error) {
    statsLoadError = "Could not load account stats. Please refresh.";
  } else {
    setCount = setsResult.count ?? 0;
    cardCount = cardsResult.count ?? 0;
  }
}
---

<Layout title="Settings">
  <PaperShell class="max-w-3xl">
    <AppTopbar />
    <header class="border-border bg-card rounded-2xl border p-6 shadow-sm">
      <h1 class="font-display text-3xl tracking-tight">Settings</h1>
      <p class="text-muted-foreground mt-2 text-sm">
        Signed in as <span class="text-foreground font-medium">{user?.email}</span>
      </p>
    </header>

    {
      statsLoadError && (
        <div class="border-destructive/30 bg-destructive/10 text-destructive mt-4 rounded-xl border px-4 py-3 text-sm">
          {statsLoadError}
        </div>
      )
    }

    {
      user?.email && (
        <AccountDangerZone
          client:load
          theme="paper"
          email={user.email}
          setCount={setCount}
          cardCount={cardCount}
          statsUnavailable={!!statsLoadError}
        />
      )
    }
  </PaperShell>
</Layout>
