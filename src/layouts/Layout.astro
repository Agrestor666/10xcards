---
import "../styles/global.css";
import Banner from "@/components/Banner.astro";
import { missingConfigs } from "@/lib/config-status";
import { t } from "@/lib/i18n";

interface Props {
  title?: string;
}

const { title = "10xCards" } = Astro.props;
const locale = Astro.locals.locale;
/** Bump when favicon assets change — browsers cache favicons aggressively. */
const faviconVersion = "2";
const icon = (path: string) => `${path}?v=${faviconVersion}`;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#3d6b52" />
    <link rel="icon" type="image/png" href={icon("/favicon.png")} sizes="32x32" />
    <link rel="icon" type="image/x-icon" href={icon("/favicon.ico")} sizes="any" />
    <link rel="shortcut icon" type="image/x-icon" href={icon("/favicon.ico")} />
    <link rel="apple-touch-icon" href={icon("/apple-touch-icon.png")} />
    <link rel="manifest" href={icon("/site.webmanifest")} />
    <title>{title}</title>
  </head>
  <body>
    {
      missingConfigs.map((cfg) => (
        <Banner variant="error">
          <strong>{t(locale, "common.warning")}</strong> {t(locale, cfg.messageKey)}
          {cfg.docsUrl && (
            <>
              {" "}
              <a href={cfg.docsUrl} target="_blank" rel="noopener noreferrer">
                {t(locale, cfg.docsLabelKey ?? "config.docs_label")}
              </a>
              .
            </>
          )}
        </Banner>
      ))
    }
    <slot />
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
  }
</style>
