---
import { cn } from "@/lib/utils";
import { t } from "@/lib/i18n";

const { user, locale } = Astro.locals;

const linkClass = cn("text-muted-foreground transition-colors hover:text-foreground hover:underline");
const brandClass = cn("font-semibold text-foreground transition-colors hover:text-primary");

const localeToggleClass = (active: boolean) =>
  cn(
    "rounded-md px-2 py-1 text-xs font-medium transition-colors",
    active
      ? "bg-primary text-primary-foreground"
      : "text-muted-foreground hover:bg-accent hover:text-accent-foreground",
  );
---

<header
  class:list={cn(
    "border-border bg-card mb-6 flex flex-wrap items-center justify-between gap-3 rounded-xl border px-4 py-3 text-sm shadow-sm",
  )}
>
  {
    user ? (
      <>
        <a href="/dashboard" class:list={brandClass}>
          10xCards
        </a>
        <div class="flex flex-wrap items-center gap-4">
          <a href="/dashboard" class:list={linkClass}>
            {t(locale, "topbar.sets")}
          </a>
          <a href="/settings" class:list={linkClass}>
            {t(locale, "topbar.settings")}
          </a>
          <form method="POST" action="/api/auth/signout">
            <button type="submit" class:list={linkClass}>
              {t(locale, "topbar.sign_out")}
            </button>
          </form>
        </div>
      </>
    ) : (
      <>
        <a href="/" class:list={brandClass}>
          10xCards
        </a>
        <div class="flex flex-wrap items-center gap-4">
          <div
            class="border-border bg-background flex items-center gap-0.5 rounded-lg border p-0.5"
            role="group"
            aria-label={t(locale, "a11y.language_selector")}
          >
            <a href="/api/locale?lang=pl" class:list={localeToggleClass(locale === "pl")}>
              {t(locale, "locale.pl")}
            </a>
            <a href="/api/locale?lang=en" class:list={localeToggleClass(locale === "en")}>
              {t(locale, "locale.en")}
            </a>
          </div>
          <a href="/auth/signin" class:list={linkClass}>
            {t(locale, "topbar.sign_in")}
          </a>
          <a
            href="/auth/signup"
            class:list={cn(
              "bg-primary text-primary-foreground rounded-lg px-3 py-1.5 font-medium transition-colors hover:opacity-90",
            )}
          >
            {t(locale, "topbar.sign_up")}
          </a>
        </div>
      </>
    )
  }
</header>
