---
import AppTopbar from "@/components/layout/AppTopbar.astro";
import PaperShell from "@/components/layout/PaperShell.astro";
import { cn } from "@/lib/utils";

const featureCards = [
  {
    title: "AI from your text",
    description: "Paste a chapter, article, or notes. Get flashcards you can edit before they land in a set.",
    icon: "book",
  },
  {
    title: "Reviews on a schedule",
    description:
      "Start with what's due today. After each answer, the app plans the next review—no spreadsheet required.",
    icon: "calendar",
  },
  {
    title: "One place to learn",
    description: "Generate, organize sets, and study from your dashboard. Your library stays private to your account.",
    icon: "stack",
  },
] as const;

const cardClass = cn("border-border bg-card rounded-xl border p-6 shadow-sm");
const iconClass = cn("text-primary mb-4 size-6");
---

<PaperShell class="max-w-4xl">
  <AppTopbar />

  <section class="flex flex-col items-center px-2 py-16 text-center sm:py-24">
    <h1 class="font-display max-w-3xl text-4xl leading-tight tracking-tight sm:text-5xl lg:text-6xl">
      Flashcards from your text. Reviews on autopilot.
    </h1>
    <p class="text-muted-foreground mt-6 max-w-2xl text-lg sm:text-xl">
      10xCards combines AI generation with spaced repetition—so you spend time learning, not formatting cards.
    </p>
    <div class="mt-10 flex flex-col gap-3 sm:flex-row sm:gap-4">
      <a
        href="/auth/signup"
        class="bg-primary text-primary-foreground inline-flex items-center justify-center rounded-lg px-6 py-3 text-base font-medium shadow-xs transition-colors hover:opacity-90"
      >
        Get started
      </a>
      <a
        href="/auth/signin"
        class="border-border bg-background text-foreground hover:bg-accent inline-flex items-center justify-center rounded-lg border px-6 py-3 text-base font-medium shadow-xs transition-colors"
      >
        Sign in
      </a>
    </div>
  </section>

  <section class="grid grid-cols-1 gap-6 pb-16 sm:grid-cols-3">
    {
      featureCards.map((card) => (
        <div class:list={cardClass}>
          {card.icon === "book" && (
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class:list={iconClass}
              aria-hidden="true"
            >
              <path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H19a1 1 0 0 1 1 1v18a1 1 0 0 1-1 1H6.5a2.5 2.5 0 0 1 0-5H20" />
            </svg>
          )}
          {card.icon === "calendar" && (
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class:list={iconClass}
              aria-hidden="true"
            >
              <path d="M8 2v4" />
              <path d="M16 2v4" />
              <rect width="18" height="18" x="3" y="4" rx="2" />
              <path d="M3 10h18" />
              <path d="M8 14h.01" />
              <path d="M12 14h.01" />
              <path d="M16 14h.01" />
              <path d="M8 18h.01" />
              <path d="M12 18h.01" />
            </svg>
          )}
          {card.icon === "stack" && (
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class:list={iconClass}
              aria-hidden="true"
            >
              <path d="M12 2 2 7l10 5 10-5-10-5Z" />
              <path d="m2 17 10 5 10-5" />
              <path d="m2 12 10 5 10-5" />
            </svg>
          )}
          <h3 class="text-lg font-semibold">{card.title}</h3>
          <p class="text-muted-foreground mt-2 text-sm leading-relaxed">{card.description}</p>
        </div>
      ))
    }
  </section>
</PaperShell>
